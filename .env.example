# --- Obligatoire : sans cette cle, aucun debat ne demarre ---
ANTHROPIC_API_KEY=

# --- Optionnel : sans cette cle, l'arene tourne en mode muet (sous-titres seuls)
#     et l'interruption micro est desactivee (clavier uniquement) ---
ELEVENLABS_API_KEY=

# --- Reglages ---
PORT=4173

# Modele des prises de parole. claude-opus-5 = le choix par defaut.
# Bascule sur claude-haiku-4-5 pour un mode turbo (plus rapide, plus plat).
DEBATE_MODEL=claude-opus-5

# low | medium | high  -> profondeur de reflexion. "low" suffit pour des repliques de 35 mots.
DEBATE_EFFORT=low

# Modele de synthese vocale ElevenLabs (flash = ~75ms de latence)
ELEVENLABS_MODEL=eleven_flash_v2_5

# Modele de transcription du micro animateur (push-to-talk)
ELEVENLABS_STT_MODEL=scribe_v1
